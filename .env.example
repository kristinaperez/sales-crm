# Скопируйте в .env и поправьте. Все строки необязательны.

# Только для боевого запуска (docker-compose.prod.yml): адрес, по которому откроется CRM.
# A-запись этого домена должна указывать на сервер.
CRM_DOMAIN=

# Порт на сервере (для локального запуска через docker-compose.yml)
CRM_PORT=8000

# Владелец создаётся при первом запуске. Если пароль не задан, он генерируется
# и один раз печатается в логах: docker compose logs crm
ADMIN_LOGIN=head
ADMIN_PASSWORD=
ADMIN_NAME=Владелец

# Часовой пояс для «Сегодня» и «Просрочено»
APP_TZ=Europe/Moscow

# Обозначение валюты рядом с суммами оплат
CURRENCY=₽

# 1 — при первом запуске на пустой базе добавить демоданные (группа, три сотрудника, восемь компаний)
SEED_DEMO=0

# Ключ подписи сессий. Если пусто — создаётся один раз и хранится на томе /data
SECRET_KEY=

# 1 — когда CRM открыта по HTTPS (cookie сессии только по защищённому соединению)
SESSION_HTTPS_ONLY=0
